ARG PB_VERSION=0.22.4
ARG GO_VERSION=1.22

# ── Go 빌드 스테이지 ────────────────────────────────────────────────────────────
FROM golang:${GO_VERSION}-alpine AS builder

ARG PB_VERSION

WORKDIR /build

# Go 모듈 초기화
# 실제 사용 시 모듈 경로를 프로젝트에 맞게 변경하세요.
RUN go mod init myapp

# PocketBase 의존성 추가
RUN go get github.com/pocketbase/pocketbase@v${PB_VERSION}

# main.go 복사 (커스텀 확장 진입점)
COPY extend/main.go .

RUN go mod tidy && \
    CGO_ENABLED=0 GOOS=linux go build -o /pocketbase .

# ── 실행 스테이지 ────────────────────────────────────────────────────────────────
FROM alpine:3.19

RUN apk add --no-cache ca-certificates curl

COPY --from=builder /pocketbase /usr/local/bin/pocketbase
RUN chmod +x /usr/local/bin/pocketbase

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /pb

EXPOSE 8090

ENTRYPOINT ["/entrypoint.sh"]
