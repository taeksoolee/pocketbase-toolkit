# PocketBase
# CI 자동 배포 기준:
# - GitHub Variables: PB_VERSION, PB_HOST_PORT
# - GitHub Secrets: PB_ADMIN_EMAIL, PB_ADMIN_PASSWORD
PB_VERSION=0.22.4
PB_HOST_PORT=8090
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme

# Cloudflare Tunnel (프로덕션)
# - GitHub Secrets: CF_TUNNEL_TOKEN
CF_TUNNEL_TOKEN=

# 도메인
# - GitHub Variables: DOMAIN
DOMAIN=example.com

# 백업 (선택)
# - GitHub Variables: BACKUP_S3_BUCKET, BACKUP_S3_REGION, BACKUP_RETENTION_DAYS
# - GitHub Secrets: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=7

# 배포(SSH 접속)
# - 로컬 make deploy 사용 시에만 아래 값 사용
# - GitHub Secrets: DEPLOY_SSH_KEY, DEPLOY_HOST, DEPLOY_USER, DEPLOY_PATH
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/opt/pocketbase
# DEPLOY_SSH_KEY= # --- IGNORE --- (GitHub Secrets ONLY - 로컬에서는 ssh-agent 또는 ~/.ssh/id_ed25519 사용)
